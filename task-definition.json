{
  "family": "rag-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::515579969505:role/rag-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::515579969505:role/rag-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "rag-api",
      "image": "515579969505.dkr.ecr.us-east-1.amazonaws.com/rag-app:latest",
      "cpu": 2048,
      "memory": 4096,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "secrets": [
        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:515579969505:parameter/rag-app/prod/DJANGO_SECRET_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:515579969505:parameter/rag-app/prod/DATABASE_URL"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:515579969505:parameter/rag-app/prod/GROQ_API_KEY"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:515579969505:parameter/rag-app/prod/REDIS_URL"
        },
        {
          "name": "METRICS_TOKEN",
          "valueFrom": "arn:aws:ssm:us-east-1:515579969505:parameter/rag-app/prod/METRICS_TOKEN"
        }
      ],
      "environment": [
        {
          "name": "DJANGO_SETTINGS_MODULE",
          "value": "config.settings.local"
        },
        {
          "name": "DEBUG",
          "value": "False"
        },
        {
          "name": "AWS_STORAGE_BUCKET_NAME",
          "value": "rag-app-talha-bucket"
        },
        {
          "name": "AWS_S3_BUCKET",
          "value": "rag-app-talha-bucket"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "ALLOWED_HOSTS",
          "value": "*"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rag-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health/', timeout=8)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 90
      }
    }
  ]
}