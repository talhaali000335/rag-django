{
  "family": "rag-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::515579969505:role/rag-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::515579969505:role/rag-ecs-task-role",
  "containerDefinitions": [{
    "name": "rag-api",
    "image": "515579969505.dkr.ecr.us-east-1.amazonaws.com/rag-app:d8df8cc29b5396c95c725a67297093d39e5ae83c",
    "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
    "essential": true,
    "environment": [
      {"name": "DJANGO_SETTINGS_MODULE", "value": "config.settings.local"},
      {"name": "DEBUG", "value": "False"},
      {"name": "ALLOWED_HOSTS", "value": "*"},
      {"name": "AWS_REGION", "value": "us-east-1"},
      {"name": "AWS_S3_BUCKET", "value": "rag-app-talha-bucket"},
      {"name": "AWS_STORAGE_BUCKET_NAME", "value": "rag-app-talha-bucket"},
      {"name": "DATABASE_URL", "value": "postgres://ragadmin:RagApp2026%21@rag-postgres.curk0u82quka.us-east-1.rds.amazonaws.com:5432/postgres"},
      {"name": "REDIS_URL", "value": "redis://rag-redis.xazwoe.0001.use1.cache.amazonaws.com:6379/0"},
      {"name": "GROQ_API_KEY", "value": "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"},
      {"name": "METRICS_TOKEN", "value": "mytoken-abc123-xyz789"},
      {"name": "DJANGO_SECRET_KEY", "value": "super-secret-key-change-me-123456"}
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/rag-api",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "ecs"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -f http://localhost:8000/health/ || exit 1"],
      "interval": 15,
      "timeout": 5,
      "retries": 2,
      "startPeriod": 30
    }
  }]
}
